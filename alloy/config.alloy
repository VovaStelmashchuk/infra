// Grafana Alloy ships the stdout/stderr of every container running on this
// node to Loki. It is deployed in global mode, so one instance runs per swarm
// node and together they cover the whole cluster.

// Discover every running container on this node through the Docker API.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"

  filter {
    name   = "status"
    values = ["running"]
  }
}

// Turn Docker/Swarm metadata into the labels we query by in Grafana.
// Labels are kept deliberately few: every unique combination is a separate
// stream in Loki, and high cardinality is what makes Loki slow and fat.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Container name, without the leading slash. Used as the fallback service
  // name for containers started outside of swarm.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "service"
  }

  // For swarm managed containers the service name is the useful identity
  // (infra_grafana, infra_caddy, ...). Only overwrites when the label exists.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    regex         = "(.+)"
    target_label  = "service"
  }

  // Stack the service belongs to: infra, nu31space, prismo, ...
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_stack_namespace"]
    regex         = "(.+)"
    target_label  = "stack"
  }

  // Swarm node this container runs on. `hostname` is set to {{.Node.Hostname}}
  // in the stack file, so it matches the node name shown by `docker node ls`.
  rule {
    target_label = "node"
    replacement  = constants.hostname
  }
}

// Stream the container logs from the Docker API into the processing pipeline.
loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.containers.output
  forward_to       = [loki.process.containers.receiver]
  refresh_interval = "15s"
}

loki.process "containers" {
  forward_to = [loki.write.loki.receiver]

  // Drop the empty lines many images print on startup, they are pure noise
  // in the log panel.
  stage.drop {
    expression = "^\\s*$"
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---------------------------------------------------------
// Metrics Collection
// ---------------------------------------------------------

// 1. Configure the Unix/Node Exporter for host metrics
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
}

// 2. Configure the cAdvisor Exporter for container metrics
prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"
  store_container_labels = true
}

// 3. Scrape both exporters
prometheus.scrape "metrics" {
  targets = concat(
    prometheus.exporter.unix.host.targets,
    prometheus.exporter.cadvisor.docker.targets,
  )

  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// 4. Send the metrics to Prometheus
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// 5. Scrape the postgres exporter, which turns pg_stat_statements and the
// other postgres statistics into metrics (query time above all).
//
// The exporter is found through the same docker discovery as the logs instead
// of being hardcoded as a static "postgres-exporter:9187" target. That way the
// exporter is scraped by the alloy instance running on its node and only by
// that one: with a static target every node would scrape the same exporter and
// push the same series to prometheus.
discovery.relabel "postgres_exporter" {
  targets = discovery.docker.containers.targets

  // Keep only the exporter container, whatever stack it is deployed under.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    regex         = ".+_postgres-exporter"
    action        = "keep"
  }

  // The exporter is attached to postgres-net and logs-net, docker discovery
  // returns one target per network. Alloy can only reach it on logs-net, and
  // scraping both would duplicate every series.
  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = ".+_logs-net"
    action        = "keep"
  }

  // Address the exporter port explicitly, the discovered one depends on what
  // the image exposes.
  rule {
    source_labels = ["__meta_docker_network_ip"]
    regex         = "(.+)"
    target_label  = "__address__"
    replacement   = "$1:9187"
  }

  // A fixed instance label. The container ip changes on every redeploy, using
  // it would start a new set of series each time.
  rule {
    target_label = "instance"
    replacement  = "postgres"
  }
}

prometheus.scrape "postgres" {
  targets         = discovery.relabel.postgres_exporter.output
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}
