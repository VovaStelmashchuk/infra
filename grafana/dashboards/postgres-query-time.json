          "expr": "topk(5, pg_slow_query_mean_seconds)",
          "refId": "A",
          "legendFormat": "{{datname}}: {{query}}"
        }
      ],
      "title": "Mean time of the 5 slowest statements",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The slowest statements by mean execution time, as postgres normalizes them ($1, $2, ... instead of the real values). Statement text is cut at 120 characters, use the query id to find the full text with: SELECT query FROM pg_stat_statements WHERE queryid = ...",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Mean time"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(20, pg_slow_query_mean_seconds)",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_slow_query_max_seconds",
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_slow_query_calls",
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "queryid",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "datname 2": true,
              "datname 3": true,
              "usename 2": true,
              "usename 3": true,
              "query 2": true,
              "query 3": true
            },
            "indexByName": {},
            "renameByName": {
              "queryid": "Query id",
              "datname": "Database",
              "datname 1": "Database",
              "usename": "Role",
              "usename 1": "Role",
              "query": "Statement",
              "query 1": "Statement",
              "Value #A": "Mean time",
              "Value #B": "Slowest execution",
              "Value #C": "Calls"
            }
          }
        }
      ],
      "title": "Slowest statements",
      "type": "table"
    }
