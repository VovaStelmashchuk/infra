    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Age of the oldest active client query at the last scrape. A number that keeps growing is a stuck or very heavy query, and it is invisible in the metrics above because those only count statements that finished.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
