  "preload": false,
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "infra",
    "logs"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "includeAll": true,
        "label": "Stack",
        "multi": true,
        "name": "stack",
        "options": [],
        "query": "label_values(stack)",
        "refresh": 2,
        "regexApplyTo": "value",
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values({stack=~\"$stack\"}, service)",
        "refresh": 2,
        "regexApplyTo": "value",
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "options": [],
        "query": "label_values(node)",
        "refresh": 2,
        "regexApplyTo": "value",
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "label": "Search (regex)",
        "name": "search",
        "query": "",
